# 复制为 deploy/.env 后修改。密码中含 $ 或 # 等字符时，用单引号包住整个值。
# MySQL 首次初始化避免在密码中使用单引号、反斜杠或换行。
MYSQL_ROOT_PASSWORD='replace-with-a-strong-root-password'
MYSQL_PASSWORD='replace-with-a-strong-app-password'

# true 只模拟分析和发送，仍使用独立演示数据库。
CONSOLE_DEMO=false
APP_BIND=127.0.0.1
APP_PORT=18062
AUTH_TOKEN=
XHS_PROXY=
OCR_ALLOW_FAKE_IP=false

# 本地 CPU OCR，不需要 API Key；false 关闭应用中的识别调用。
# OCR 只在容器内部可达，不映射宿主端口；禁用识别不会删除 OCR 镜像。
OCR_ENABLED=true

# 相对 deploy 目录，仅 compose.external.yaml 使用。
MYSQL_CONFIG_FILE=../backend/config/mysql.docker.json
